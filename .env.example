# Required. Create a project at supabase.com and copy these from
# Project Settings, API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required only if you want people to be able to save their own AI key.
# Without it the app still reads orders with its built in parser.
# Generate one with:  openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Optional. Leave blank and share links use the host of the request, which
# is correct on localhost and on your deployed domain alike.
NEXT_PUBLIC_SITE_URL=

# There is deliberately no service role key here. The app does not use one.
